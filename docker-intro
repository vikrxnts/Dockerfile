### Secure Registry


mkdit certs

openssl req -newkey rsa:4096 -nodes -sha256 -keyout certs/domain.key -x509 -days 365 -out certs/domain.crt

# comman name - myregistry.local

mkdir /etc/docker/certs.d/myregistry.local:5000/

cp certs/domain.crt domain.key /etc/docker/certs.d/myregistry.local:5000/

systemctl restart docker


docker run -itd --name secure_registry -p 5000:5000 -v certs:/certs -e  REGISTRY_HTTP_TLS_CERTIFICATE=/certs/domain.crt -e REGISTRY_HTTP_TLS_KEY=/certs/domain.key registry

curl --cacert certs/domain.crt https://myregistry.local:5000/v2/_catalog

docker tag cnt1:v4ssh myregistry.local:5000/cn1:ssh

docker push myregistry.local:5000/cn1:ssh


### Authentication with security

mkdir auth

docker run --rm \
  --entrypoint htpasswd \
  httpd:2 -Bbn admin your_password > auth/htpasswd


docker run -d \
  -p 5000:5000 \
  --restart=always \
  --name secure-registry \
  -v "$(pwd)"/certs:/certs \
  -v "$(pwd)"/auth:/auth \
  -e REGISTRY_HTTP_TLS_CERTIFICATE=/certs/domain.crt \
  -e REGISTRY_HTTP_TLS_KEY=/certs/domain.key \
  -e REGISTRY_AUTH=htpasswd \
  -e REGISTRY_AUTH_HTPASSWD_REALM="Registry Realm" \
  -e REGISTRY_AUTH_HTPASSWD_PATH=/auth/htpasswd \
  registry


docker login myregistry.local:5000     # login 

